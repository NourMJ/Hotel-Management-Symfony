{% extends 'base.html.twig' %}

{% block title %}Room details{% endblock %}

{% block body %}
    <div class="container my-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">Room #{{ room.roomNumber }}</h1>
            <div>
                <a href="{{ path('app_admin_room_index') }}" class="btn btn-outline-secondary btn-sm">Back to list</a>
                <a href="{{ path('app_admin_room_edit', {'id': room.id}) }}" class="btn btn-warning btn-sm">Edit</a>
                {{ include('admin_room/_delete_form.html.twig') }}
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">{{ room.title }}</h5>
                        <p class="text-muted">
                            Category:
                            {% if room.category %}
                                <span class="badge bg-info text-dark">{{ room.category.name }}</span>
                            {% else %}
                                <span class="text-muted">No category</span>
                            {% endif %}
                        </p>
                        <p>{{ room.description }}</p>

                        <div class="row mt-3">
                            <div class="col-sm-6">
                                <div><strong>Price per night:</strong> {{ room.pricePerNight }} €</div>
                                <div><strong>Capacity:</strong> {{ room.capacity }} guests</div>
                                <div><strong>Floor:</strong> {{ room.floor }}</div>
                            </div>
                            <div class="col-sm-6">
                                <div><strong>Amenities:</strong></div>
                                <div class="small">
                                    {{ room.amenities ? room.amenities|json_encode : 'None' }}
                                </div>
                                <div class="mt-2"><strong>Image:</strong> {{ room.image }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
